# Copy this file to .env and fill in whatever keys you've signed up for.
# Every agent works without ANY key set except News, RAG, Vision-description and
# Translation, which report status "not_configured" instead of faking data.

# Free at https://aistudio.google.com/apikey — powers Vision description, RAG
# embeddings+answers, Translation, and the Report agent's SITREP prose.
GEMINI_API_KEY=

# Free at https://gnews.io (~100 req/day) — used by the News agent.
GNEWS_API_KEY=

# Alternative to GNews, free at https://newsdata.io — used only if GNEWS_API_KEY is unset.
NEWSDATA_API_KEY=

# Optional — only needed if you swap the Vision agent from NASA GIBS (no key) to
# Sentinel Hub for higher-resolution tiles. Free tier at https://www.sentinel-hub.com/
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=
